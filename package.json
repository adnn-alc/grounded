{
  "name": "grounded",
  "version": "1.6.0",
  "description": "Self-hosted espresso & filter coffee tracker: dial-in log, beans, gear and stats in one Docker container",
  "keywords": [
    "coffee",
    "espresso",
    "pour-over",
    "filter-coffee",
    "dial-in",
    "self-hosted",
    "homelab",
    "sqlite",
    "react",
    "docker"
  ],
  "homepage": "https://github.com/adnn-alc/grounded#readme",
  "bugs": {
    "url": "https://github.com/adnn-alc/grounded/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnn-alc/grounded.git"
  },
  "author": "adnn-alc (https://github.com/adnn-alc)",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:ui": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "oxlint",
    "test": "node --test server/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
