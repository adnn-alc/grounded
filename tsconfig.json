{
  // Type-checking only: Vite builds the UI and Node runs the server directly,
  // so tsc never emits anything (`npm run typecheck`).
  // This config covers the UI in src/; server/tsconfig.json covers the API.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
